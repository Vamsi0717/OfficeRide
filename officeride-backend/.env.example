SECRET_KEY=change-me-to-a-long-random-string
DB_NAME=officeride
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional (Phase 2): comma-separated company domains allowed to sign up, e.g. acme.com,globex.com
# Leave empty to accept any company email (personal ones like Gmail are always blocked).
ALLOWED_EMAIL_DOMAINS=

# Optional: sender shown on OTP emails
DEFAULT_FROM_EMAIL=OfficeRide <no-reply@officeride.local>

# Only needed in production (config.settings.prod) to send real emails
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1

# Maps (Phase 3). Use "fake" while developing (sample Bangalore places, no key needed).
# Use "google" once you have a Google Maps Platform key with Places API (New) and Routes API enabled.
MAPS_PROVIDER=fake
GOOGLE_MAPS_API_KEY=